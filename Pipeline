
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'SYS', 'SYS2'],
            description: 'Select the environment to execute the pipeline'
        )
    }

    stages {

        stage('Build') {
            steps {
                echo 'Starting Build Stage'
                echo "Selected Environment: ${params.ENVIRONMENT}"
                echo "Building application for ${params.ENVIRONMENT}"
                echo 'Build Completed Successfully'
            }
        }

        stage('Test') {
            steps {
                echo 'Starting Test Stage'
                echo "Testing application in ${params.ENVIRONMENT}"
                echo 'All Tests Passed Successfully'
            }
        }
    }

    post {
        success {
            echo "Pipeline Executed Successfully for ${params.ENVIRONMENT}!"
        }

        failure {
            echo 'Pipeline Execution Failed!'
        }
    }
}
